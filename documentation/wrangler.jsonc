{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shrinkage-docs",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "main": "./site/__diplodocus/worker.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "shrinkage.cc", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
