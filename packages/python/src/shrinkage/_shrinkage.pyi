from typing import Literal

_PenaltySpec = tuple[str, float, float, tuple[float, ...] | None]
_PolicySpec = tuple[str, int, bool]
_PolicyRecord = tuple[Literal["auto", "disabled", "ever_active", "adaptive"], int, bool]
_StepSpec = tuple[str, float | None, int]

__version__: str

def _core_smoke_test() -> float: ...

class _DenseInputs:
    @property
    def shape(self) -> tuple[int, int]: ...
    def _snapshot(self) -> tuple[list[float], list[float]]: ...

def _prepare_dense_inputs(
    x: object, y: object, *, copy: bool = True
) -> _DenseInputs: ...

class _Lasso:
    def __init__(
        self,
        lambda_: float,
        fit_intercept: bool,
        normalization: str,
        stopping: tuple[str, float, float] | None,
        max_iterations: int,
    ) -> None: ...
    def fit(self, x: object, y: object, *, copy: bool = True) -> _LassoFit: ...

class _LassoFit:
    @property
    def coefficients(self) -> list[float]: ...
    @property
    def intercept(self) -> float: ...
    @property
    def centers(self) -> list[float] | None: ...
    @property
    def scales(self) -> list[float] | None: ...
    @property
    def centering(self) -> str: ...
    @property
    def scaling(self) -> str: ...
    @property
    def termination(self) -> Literal["converged", "iteration_limit"]: ...
    @property
    def iterations(self) -> int: ...
    @property
    def objective(self) -> float: ...
    @property
    def kkt_violation(self) -> float: ...
    @property
    def dual_certificate(self) -> list[float]: ...
    @property
    def dual_objective(self) -> float: ...
    @property
    def duality_gap(self) -> float: ...
    @property
    def reference_loss(self) -> float: ...
    @property
    def stopping(
        self,
    ) -> tuple[Literal["duality_gap", "kkt_violation"], float, float]: ...
    @property
    def stopping_value(self) -> float: ...
    @property
    def stopping_threshold(self) -> float: ...
    def predict(self, x: object, *, copy: bool = True) -> list[float]: ...

class _Solver:
    @staticmethod
    def hybrid(
        stopping: tuple[str, float, float] | None,
        max_iterations: int,
        max_outer_iterations: int,
        max_inner_iterations: int,
        max_outer_backtracks: int,
        cluster_sweeps: int,
        check_every: int,
        screening: bool,
        working_set_policy: _PolicySpec,
        step_policy: _StepSpec,
    ) -> _Solver: ...
    @staticmethod
    def proximal_gradient(
        stopping: tuple[str, float, float] | None,
        max_iterations: int,
        initial_step: float,
        max_backtracks: int,
        screening: bool,
    ) -> _Solver: ...
    def fit(
        self,
        x: object,
        y: object,
        family: str,
        fit_intercept: bool,
        normalization_name: str,
        penalty: _PenaltySpec,
        *,
        copy: bool = True,
    ) -> _ModelFit: ...

class _ModelFit:
    @property
    def solver(self) -> Literal["hybrid", "proximal_gradient"]: ...
    @property
    def family(self) -> Literal["gaussian", "binomial"]: ...
    @property
    def coefficients(self) -> list[float]: ...
    @property
    def intercept(self) -> float: ...
    @property
    def centers(self) -> list[float] | None: ...
    @property
    def scales(self) -> list[float] | None: ...
    @property
    def centering(self) -> str: ...
    @property
    def scaling(self) -> str: ...
    @property
    def termination(self) -> Literal["converged", "iteration_limit"]: ...
    @property
    def iterations(self) -> int: ...
    @property
    def objective(self) -> float: ...
    @property
    def stopping_value(self) -> float: ...
    @property
    def stopping_threshold(self) -> float: ...
    @property
    def step_size(self) -> float: ...
    @property
    def dual_certificate(self) -> list[float] | None: ...
    @property
    def dual_objective(self) -> float | None: ...
    @property
    def duality_gap(self) -> float | None: ...
    @property
    def screening_diagnostics(self) -> tuple[bool, int, int, int, int, int, int]: ...
    @property
    def working_set_diagnostics(
        self,
    ) -> tuple[_PolicyRecord, int, int, int, int, int, int, int, int, int]: ...
    @property
    def cluster_labels(self) -> list[int]: ...
    @property
    def cluster_values(self) -> list[float]: ...
    @property
    def coefficient_signs(self) -> list[float]: ...
    @property
    def pg_steps(self) -> int: ...
    @property
    def coordinate_sweeps(self) -> int: ...
    @property
    def diagnostic_checks(self) -> int: ...
    @property
    def backtracks(self) -> int: ...
    @property
    def outer_iterations(self) -> int: ...
    @property
    def outer_backtracks(self) -> int: ...
    @property
    def step_policy(
        self,
    ) -> tuple[Literal["backtracking", "fixed_bound"], float | None, int]: ...
    def predict(self, x: object, *, copy: bool = True) -> list[float]: ...
