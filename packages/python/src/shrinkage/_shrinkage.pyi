from typing import Literal

__version__: str

def _core_smoke_test() -> float: ...

class _DenseInputs:
    @property
    def shape(self) -> tuple[int, int]: ...
    def _snapshot(self) -> tuple[list[float], list[float]]: ...

def _prepare_dense_inputs(
    x: object, y: object, *, copy: bool = True
) -> _DenseInputs: ...

class _Lasso:
    def __init__(
        self,
        lambda_: float,
        fit_intercept: bool,
        normalization: str,
        stopping: tuple[str, float, float] | None,
        max_iterations: int,
    ) -> None: ...
    def fit(self, x: object, y: object, *, copy: bool = True) -> _LassoFit: ...

class _LassoFit:
    @property
    def coefficients(self) -> list[float]: ...
    @property
    def intercept(self) -> float: ...
    @property
    def centers(self) -> list[float] | None: ...
    @property
    def scales(self) -> list[float] | None: ...
    @property
    def centering(self) -> str: ...
    @property
    def scaling(self) -> str: ...
    @property
    def termination(self) -> Literal["converged", "iteration_limit"]: ...
    @property
    def iterations(self) -> int: ...
    @property
    def objective(self) -> float: ...
    @property
    def kkt_violation(self) -> float: ...
    @property
    def dual_certificate(self) -> list[float]: ...
    @property
    def dual_objective(self) -> float: ...
    @property
    def duality_gap(self) -> float: ...
    @property
    def reference_loss(self) -> float: ...
    @property
    def stopping(
        self,
    ) -> tuple[Literal["duality_gap", "kkt_violation"], float, float]: ...
    @property
    def stopping_value(self) -> float: ...
    @property
    def stopping_threshold(self) -> float: ...
    def predict(self, x: object, *, copy: bool = True) -> list[float]: ...
